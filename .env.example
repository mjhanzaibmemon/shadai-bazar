# ── Core ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/rukhsati
JWT_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_BASE_URL=https://ruksati.com
# Set to "true" when serving over HTTPS so the auth cookie is Secure
COOKIE_SECURE=true

# ── Email (Resend) ───────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=Rukhsati <noreply@ruksati.com>

# ── Image storage (Cloudinary, optional — falls back to local disk) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Web Push (generate with: npx web-push generate-vapid-keys) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@ruksati.com

# ── Payments (JazzCash) ──────────────────────────────
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=

# ── SEO / Analytics (optional) ───────────────────────
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
